# ============================================================
# Mobile App — Buruan Sae 2.0
# Salin file ini ke .env dan isi nilainya
# JANGAN commit .env ke repository!
# ============================================================

# ── Backend API
API_BASE_URL=https://api.buruansae.bandung.go.id

# ── Midtrans (Payment)
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx

# ── Fonnte (WhatsApp OTP)
FONNTE_API_KEY=your_fonnte_api_key

# ── Environment: development | staging | production
APP_ENV=development
