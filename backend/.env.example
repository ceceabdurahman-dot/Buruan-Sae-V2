# ============================================================
# .env.example — Template Konfigurasi Backend Buruan Sae 2.0
# Salin ke .env (development) atau .env.production
# JANGAN commit file .env ke repository!
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=https://admin.buruansae.bandung.go.id

# ── Database (PostgreSQL + PostGIS) ───────────────────────────
DATABASE_URL=postgresql://buruan_sae:GANTI_PASSWORD@postgres:5432/buruan_sae

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:GANTI_REDIS_PASSWORD@redis:6379/0

# ── JWT (minimal 64 karakter random) ──────────────────────────
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_64_KARAKTER_MINIMUM_JANGAN_BOCOR
JWT_REFRESH_SECRET=GANTI_DENGAN_RANDOM_STRING_BERBEDA_UNTUK_REFRESH_TOKEN
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ── Enkripsi NIK (AES-256-GCM) ────────────────────────────────
ENCRYPTION_KEY=GANTI_DENGAN_32_BYTES_RANDOM_HEX_JANGAN_UBAH_SETELAH_PRODUKSI
ENCRYPTION_SALT=buruan-sae-v1

# ── MinIO (Object Storage) ────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=GANTI_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=GANTI_MINIO_SECRET_KEY
MINIO_BUCKET_PUBLIC=buruan-sae-public
MINIO_BUCKET_PRIVATE=buruan-sae-private

# ── Midtrans (Payment Gateway) ────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# ── Fonnte (WhatsApp OTP) ─────────────────────────────────────
FONNTE_API_KEY=GANTI_DENGAN_FONNTE_API_KEY
FONNTE_DEVICE=NOMOR_WA_BISNIS_ANDA

# ── FCM (Firebase Cloud Messaging v1) ─────────────────────────
FCM_PROJECT_ID=buruan-sae-app
FCM_SERVICE_ACCOUNT_KEY_BASE64=BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Seed Data ─────────────────────────────────────────────────
SEED_ADMIN_NIK=3273010000000001
SEED_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT
SEED_ADMIN_WA=62811111111111
SEED_ADMIN_EMAIL=admin@buruansae.bandung.go.id

# ── Monitoring ────────────────────────────────────────────────
PROMETHEUS_TOKEN=GANTI_TOKEN_METRICS_SCRAPING
