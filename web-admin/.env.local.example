# ============================================================
# Web Admin — Buruan Sae 2.0
# Salin file ini ke .env.local dan isi nilainya
# JANGAN commit .env.local ke repository!
# ============================================================

# ── NextAuth ─────────────────────────────────────────────────
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=ganti_dengan_secret_acak_yang_kuat

# URL aplikasi web admin (tanpa trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ── Backend API ──────────────────────────────────────────────
# Digunakan oleh NextAuth route handler (server-side)
API_BASE_URL=http://localhost:3001

# Digunakan oleh api-client.ts (client-side, harus diawali NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
